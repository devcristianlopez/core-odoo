<odoo>
    <record id="view_crm_lead_list" model="ir.ui.view">
        <field name="name">crm.demo.lead.list</field>
        <field name="model">crm.demo.lead</field>
        <field name="arch" type="xml">
            <list string="Leads">
                <field name="name"/>
                <field name="contact_name"/>
                <field name="email" optional="show"/>
                <field name="phone" optional="hide"/>
                <field name="stage" widget="badge"/>
                <field name="expected_revenue" sum="Expected revenue"/>
                <field name="create_date" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_crm_lead_form" model="ir.ui.view">
        <field name="name">crm.demo.lead.form</field>
        <field name="model">crm.demo.lead</field>
        <field name="arch" type="xml">
            <form string="Lead">
                <header>
                    <field name="stage" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Lead name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="contact_name"/>
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                        </group>
                        <group>
                            <field name="expected_revenue"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_crm_lead_search" model="ir.ui.view">
        <field name="name">crm.demo.lead.search</field>
        <field name="model">crm.demo.lead</field>
        <field name="arch" type="xml">
            <search string="Leads">
                <field name="name"/>
                <field name="contact_name"/>
                <field name="email"/>
                <filter name="won" string="Won" domain="[('stage', '=', 'won')]"/>
                <filter name="lost" string="Lost" domain="[('stage', '=', 'lost')]"/>
            </search>
        </field>
    </record>

    <record id="action_crm_lead" model="ir.actions.act_window">
        <field name="name">Leads</field>
        <field name="res_model">crm.demo.lead</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first lead</p>
        </field>
    </record>

    <menuitem id="menu_crm_demo_root" name="CRM Demo" sequence="90"/>
    <menuitem id="menu_crm_demo_leads" name="Leads" parent="menu_crm_demo_root" action="action_crm_lead" sequence="10"/>
</odoo>
