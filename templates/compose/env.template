# Core Odoo — environment variables.
#
# Copy to data/envs/<project>-<stage>/.env (or pass with --env-file). Secrets
# are generated by the orchestrator per environment and never committed.

# --- Rendering context -------------------------------------------------------
CORE_REPO_ROOT=/absolute/path/to/core-odoo
CORE_PROJECT_DIR=/absolute/path/to/core-odoo/projects/smoke-test
CORE_PROJECT=smoke-test
CORE_STAGE=dev
CORE_DOMAIN_SUFFIX=192.168.1.50.nip.io

# --- Stage limits (see docs/ARCHITECTURE.md § Environments) ------------------
# dev: 2g / 2 CPU · staging: 3g / 2 CPU · prod: 4g / 4 CPU
CORE_MEM_LIMIT=2g
CORE_CPU_LIMIT=2
CORE_LOG_LEVEL=INFO
CORE_WORKERS=0

# --- Odoo --------------------------------------------------------------------
ODOO_DB=smoke_test_dev
ODOO_MASTER_PASSWORD=change-me
POSTGRES_PASSWORD=change-me
ODOO_INIT_MODULES=smoke_test
ODOO_WITHOUT_DEMO=all
ODOO_DEMO=0

# --- Gateway -----------------------------------------------------------------
ODOO_API_KEY=change-me
GATEWAY_JWT_SECRET=change-me
