# Generated by the Core Odoo orchestrator. Do not edit by hand:
# changes are overwritten on the next deploy.
name: {{ compose_project }}

services:
  db:
    image: postgres:16-alpine
    container_name: {{ compose_project }}-db
    restart: unless-stopped
    environment:
      POSTGRES_USER: "odoo"
      POSTGRES_PASSWORD: {{ db_password | tojson }}
      POSTGRES_DB: "postgres"
      PGDATA: "/var/lib/postgresql/data/pgdata"
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U odoo -d postgres"]
      interval: 5s
      timeout: 5s
      retries: 30
    networks:
      - internal
    labels:
      core.metrics: "true"
      core.project: {{ project | tojson }}
      core.stage: {{ stage | tojson }}
      core.service: "db"

  odoo:
    image: odoo:20
    container_name: {{ compose_project }}-odoo
    restart: unless-stopped
    depends_on:
      db:
        condition: service_healthy
    environment:
      POSTGRES_HOST: "db"
      POSTGRES_DB: {{ db_name | tojson }}
      POSTGRES_USER: "odoo"
      POSTGRES_PASSWORD: {{ db_password | tojson }}
      ODOO_DB: {{ db_name | tojson }}
      ODOO_INIT_MODULES: {{ init_modules | tojson }}
      ODOO_DEMO: "0"
      CORE_WORKERS: {{ workers | tojson }}
      ODOO_CONF: "/etc/odoo/odoo.conf"
    entrypoint: ["/bin/bash", "/entrypoint.sh"]
    volumes:
      - odoo_data:/var/lib/odoo
      - backups:/backups
      - {{ (addons_dir ~ ':/mnt/extra-addons:ro') | tojson }}
      - {{ (odoo_conf ~ ':/etc/odoo/odoo.conf:ro') | tojson }}
      - {{ (entrypoint ~ ':/entrypoint.sh:ro') | tojson }}
    expose:
      - "8069"
    healthcheck:
      test: ["CMD-SHELL", "python3 -c \"import urllib.request as u; u.urlopen('http://127.0.0.1:8069/web/login', timeout=5)\""]
      interval: 10s
      timeout: 5s
      retries: 60
      start_period: 300s
    networks:
      - internal
      - edge
    labels:
      core.metrics: "true"
      core.project: {{ project | tojson }}
      core.stage: {{ stage | tojson }}
      core.service: "odoo"
      traefik.enable: "true"
      traefik.docker.network: "core-edge"
      "traefik.http.routers.{{ project }}-{{ stage }}-odoo.rule": "Host(`{{ odoo_host }}`)"
      "traefik.http.routers.{{ project }}-{{ stage }}-odoo.entrypoints": "web"
      "traefik.http.routers.{{ project }}-{{ stage }}-odoo.service": "{{ project }}-{{ stage }}-odoo"
      "traefik.http.services.{{ project }}-{{ stage }}-odoo.loadbalancer.server.port": "8069"
      "traefik.http.routers.{{ project }}-{{ stage }}-odoo.middlewares": "{{ project }}-{{ stage }}-odoo-allowlist"
      "traefik.http.routers.{{ project }}-{{ stage }}-odoo-tls.rule": "Host(`{{ odoo_host }}`)"
      "traefik.http.routers.{{ project }}-{{ stage }}-odoo-tls.entrypoints": "websecure"
      "traefik.http.routers.{{ project }}-{{ stage }}-odoo-tls.tls": "true"
      "traefik.http.routers.{{ project }}-{{ stage }}-odoo-tls.service": "{{ project }}-{{ stage }}-odoo"
      "traefik.http.routers.{{ project }}-{{ stage }}-odoo-tls.middlewares": "{{ project }}-{{ stage }}-odoo-allowlist"
      "traefik.http.middlewares.{{ project }}-{{ stage }}-odoo-allowlist.ipallowlist.sourcerange": {{ odoo_ui_cidrs | tojson }}
    deploy:
      resources:
        limits:
          cpus: {{ cpu_limit | tojson }}
          memory: {{ memory_limit | tojson }}

{% if smtp_enabled %}
  mailpit:
    image: axllent/mailpit:latest
    container_name: {{ compose_project }}-mailpit
    restart: unless-stopped
    expose:
      - "1025"
      - "8025"
    networks:
      - internal
    labels:
      core.metrics: "true"
      core.project: {{ project | tojson }}
      core.stage: {{ stage | tojson }}
      core.service: "mailpit"
{% endif %}

  bootstrap:
    image: odoo:20
    container_name: {{ compose_project }}-bootstrap
    restart: "no"
    user: "0:0"
    depends_on:
      odoo:
        condition: service_healthy
    environment:
      ODOO_DB: {{ db_name | tojson }}
      ODOO_CONF: "/etc/odoo/odoo.conf"
      CORE_PUBLIC_URL: {{ public_url | tojson }}
      POSTGRES_HOST: "db"
      POSTGRES_USER: "odoo"
      POSTGRES_PASSWORD: {{ db_password | tojson }}
      ODOO_ADMIN_PASSWORD: {{ admin_password | tojson }}
    entrypoint: ["/bin/bash", "/opt/core/bootstrap.sh"]
    volumes:
      - secrets:/run/core
      - {{ (bootstrap_sh ~ ':/opt/core/bootstrap.sh:ro') | tojson }}
      - {{ (bootstrap_py ~ ':/opt/core/bootstrap.py:ro') | tojson }}
      - {{ (odoo_conf ~ ':/etc/odoo/odoo.conf:ro') | tojson }}
    networks:
      - internal

  gateway:
    build:
      context: {{ gateway_dir | tojson }}
      dockerfile: Dockerfile
    image: {{ compose_project }}-gateway
    container_name: {{ compose_project }}-gateway
    restart: unless-stopped
    depends_on:
      bootstrap:
        condition: service_completed_successfully
    environment:
      BACKEND_CONFIG: "/app/backend.yaml"
      ODOO_URL: "http://odoo:8069"
      ODOO_DB: {{ db_name | tojson }}
      ODOO_API_KEY: "file:/run/core/odoo_api_key"
      GATEWAY_JWT_SECRET: {{ gateway_jwt_secret | tojson }}
      CORE_PROJECT: {{ project | tojson }}
      CORE_STAGE: {{ stage | tojson }}
      CORE_DOMAIN_SUFFIX: {{ domain_suffix | tojson }}
      CORE_LOG_LEVEL: "INFO"
    volumes:
      - {{ (backend_config ~ ':/app/backend.yaml:ro') | tojson }}
      - secrets:/run/core:ro
    expose:
      - "8000"
    networks:
      - internal
    healthcheck:
      test: ["CMD-SHELL", "python3 -c \"import urllib.request as u; u.urlopen('http://127.0.0.1:8000/health', timeout=5)\""]
      interval: 10s
      timeout: 5s
      retries: 30
      start_period: 30s
    labels:
      core.metrics: "true"
      core.project: {{ project | tojson }}
      core.stage: {{ stage | tojson }}
      core.service: "gateway"
    deploy:
      resources:
        limits:
          cpus: "0.5"
          memory: "512m"

  frontend:
    build:
      context: {{ frontend_dir | tojson }}
      dockerfile: Dockerfile
    image: {{ compose_project }}-frontend
    container_name: {{ compose_project }}-frontend
    restart: unless-stopped
    depends_on:
      gateway:
        condition: service_started
    expose:
      - "80"
    networks:
      - internal
      - edge
    labels:
      core.metrics: "true"
      core.project: {{ project | tojson }}
      core.stage: {{ stage | tojson }}
      core.service: "frontend"
      traefik.enable: "true"
      traefik.docker.network: "core-edge"
      "traefik.http.routers.{{ router_name }}.rule": "Host(`{{ host }}`)"
      "traefik.http.routers.{{ router_name }}.entrypoints": "web"
      "traefik.http.routers.{{ router_name }}.service": "{{ router_name }}"
      "traefik.http.services.{{ router_name }}.loadbalancer.server.port": "80"
      "traefik.http.routers.{{ router_name }}-tls.rule": "Host(`{{ host }}`)"
      "traefik.http.routers.{{ router_name }}-tls.entrypoints": "websecure"
      "traefik.http.routers.{{ router_name }}-tls.tls": "true"
      "traefik.http.routers.{{ router_name }}-tls.service": "{{ router_name }}"
    deploy:
      resources:
        limits:
          cpus: "0.25"
          memory: "256m"

networks:
  internal:
    name: {{ compose_project }}_default
  edge:
    name: core-edge
    external: true

volumes:
  pgdata:
    name: {{ compose_project }}_pgdata
  odoo_data:
    name: {{ compose_project }}_odoo_data
  backups:
    name: {{ compose_project }}_backups
  secrets:
    name: {{ compose_project }}_secrets
