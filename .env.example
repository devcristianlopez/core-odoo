# Core Odoo control plane — copy to .env (or run `core-odoo init`)
CORE_LANG=es
CORE_DOMAIN_SUFFIX=192.168.1.50.nip.io
CORE_API_URL=http://api.core-odoo.192.168.1.50.nip.io
CORE_ADMIN_USER=admin
CORE_ADMIN_PASSWORD=change-me
CORE_API_TOKEN=change-me
CORE_JWT_SECRET=change-me
CORE_ODOO_MASTER_PASSWORD=change-me
CORE_DATA_DIR=./data
CORE_PROJECTS_DIR=./projects
CORE_TEMPLATES_DIR=./templates
# Absolute host paths used for bind mounts when the orchestrator runs in Docker.
# core-odoo init fills these automatically.
CORE_HOST_DATA_DIR=
CORE_HOST_PROJECTS_DIR=
CORE_HOST_GATEWAY_DIR=
CORE_LOG_LEVEL=INFO
CORE_DOCKER_SOCKET=/var/run/docker.sock
# Deploy health gate: the gateway must report odoo=true within this timeout (s).
CORE_DEPLOY_HEALTH_TIMEOUT=300
CORE_DEPLOY_HEALTH_INTERVAL=5
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
PROMETHEUS_RETENTION=15d
LOKI_RETENTION=336h
