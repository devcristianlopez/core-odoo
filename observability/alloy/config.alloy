// Alloy — Docker log collection for Core Odoo.
//
// Discovers every container on the host and ships its stdout/stderr to Loki.
// Containers labelled `core.project` / `core.stage` (set by the orchestrator
// when it creates an environment) get those values as Loki labels, so
// Grafana can filter logs per environment:
//
//   {project="smoke-test", stage="dev"}

discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "15s"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_core_project"]
    target_label  = "project"
  }

  rule {
    source_labels = ["__meta_docker_container_label_core_stage"]
    target_label  = "stage"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.relabel.containers.output
  labels        = { job = "docker" }
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
